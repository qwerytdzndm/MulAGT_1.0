# Never commit a real key. Copy this file to .env and fill it locally.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# deepseek: real API; mock: deterministic offline development and tests.
MUL_LLM_MODE=mock
MUL_LLM_MAX_OUTPUT_TOKENS=12000
MUL_MAX_FILES=400
MUL_MAX_FILE_BYTES=200000
MUL_RAG_TOP_K=8
MUL_RAG_CANDIDATE_K=32
MUL_RAG_SCORE_THRESHOLD=0.05
MUL_RAG_MAX_CHUNKS_PER_DOCUMENT=3
MUL_RAG_CHUNK_TOKENS=512
MUL_RAG_CHUNK_OVERLAP_TOKENS=64

# Use deterministic providers for fast local tests; switch to bge-m3/bge for
# production retrieval quality after model download/cache is configured.
MUL_RAG_EMBEDDING_PROVIDER=deterministic
MUL_RAG_EMBEDDING_MODEL=BAAI/bge-m3
MUL_RAG_RERANKER_PROVIDER=deterministic
MUL_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
MUL_RAG_DEVICE=auto
MUL_RAG_MODEL_CACHE=.mul/rag/models
MUL_RAG_EMBEDDING_BATCH_SIZE=8
MUL_RAG_RERANKER_BATCH_SIZE=4
MUL_RAG_RERANKER_MAX_LENGTH=1024

# Leave URL empty for embedded persistent Qdrant.
MUL_QDRANT_URL=
MUL_QDRANT_API_KEY=
MUL_QDRANT_PATH=.mul/rag/qdrant
MUL_QDRANT_TIMEOUT_SECONDS=30

# auto: Docling when installed, pypdf fallback for text PDFs.
# docling: require OCR/layout parsing; text-only: disable Office/OCR parsing.
MUL_RAG_DOCUMENT_PARSER=auto
MUL_DOCLING_ARTIFACTS_PATH=
MUL_RAG_MAX_DOCUMENT_BYTES=25000000
MUL_RAG_MAX_DOCUMENT_PAGES=200

MUL_TEST_TIMEOUT_SECONDS=120
MUL_MAX_CACHED_INDICES=32
MUL_MAX_WORKERS=4
MUL_MAX_PENDING_RUNS=16

# Limit the repositories mul may read or modify.
MUL_WORKSPACE_ROOTS=C:\workplace

# Unsafe by default: pytest/unittest execute repository code on the host.
# Prefer isolated CI. Enable only for a repository you explicitly trust.
MUL_ALLOW_HOST_TEST_EXECUTION=0

# Deterministic context compression budgets for each model-facing agent.
MUL_CONTEXT_MAX_INPUT_TOKENS=64000
MUL_CONTEXT_PLANNER_TOKENS=28000
MUL_CONTEXT_CODER_TOKENS=64000
MUL_CONTEXT_REVIEWER_TOKENS=48000
MUL_CONTEXT_REFLECTION_TOKENS=32000
MUL_CONTEXT_MAX_EVIDENCE_ITEM_TOKENS=2000
MUL_CONTEXT_MAX_FILE_ITEM_TOKENS=12000
MUL_CONTEXT_MAX_DIFF_TOKENS=24000
MUL_CONTEXT_MAX_TEST_OUTPUT_TOKENS=8000
